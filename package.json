{
  "name": "bsmoss",
  "version": "0.0.0",
  "private": true,
  "description": "Base Station Multi-domain Operation and Supervision System",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "seed:tower-history": "tsx scripts/seed-tower-history.ts",
    "test": "node scripts/test.mjs",
    "test:coverage": "node scripts/test.mjs --coverage",
    "type-check:all": "tsc --noEmit && pnpm --filter @bsmoss/app type-check",
    "lint:docs-numbering": "node scripts/guardrails/check-docs-numbering.mjs --strict",
    "lint:schema-mirror": "node scripts/guardrails/check-schema-mirror.mjs",
    "test:db": "node --import tsx --test scripts/database/contract.test.mjs",
    "prisma:validate": "prisma validate --schema portals/app/prisma/schema.prisma",
    "build": "pnpm --filter @bsmoss/app build",
    "build:worker": "node scripts/build-worker.mjs",
    "test:worker-host": "node --test scripts/worker-host-smoke.test.mjs scripts/worker-delivery.test.mjs",
    "test:portal": "node --import tsx --test scripts/demo-auth.test.mjs && node --test scripts/portal-smoke.test.mjs",
    "lint:sca": "node scripts/guardrails/check-sca-consistency.mjs --strict",
    "lint:delivery": "node scripts/guardrails/check-delivery.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "8.15.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.1",
    "pg": "8.22.0",
    "prisma": "7.8.0",
    "tsx": "4.21.0",
    "typescript": "~5.9.3",
    "yaml": "2.8.3",
    "parse5": "8.0.0"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.23": ">=8.5.23",
      "sharp@<0.35.5": ">=0.35.5",
      "source-map-js@<1.2.2": ">=1.2.2",
      "nanoid@<3.3.18": ">=3.3.18 <4",
      "fast-uri@<3.1.8": ">=3.1.8 <4",
      "valibot@<1.4.2": ">=1.4.2",
      "deepmerge-ts@<8.0.0": ">=8.0.0",
      "mysql2@<3.23.1": ">=3.23.1",
      "react-resizable-panels": "4.12.3",
      "@hono/node-server@<2.1.6": ">=2.1.6",
      "hono@<4.13.16": ">=4.13.16",
      "esbuild@<0.28.1": ">=0.28.1"
    },
    "patchedDependencies": {
      "@vxture/design-system@15.6.1": "patches/@vxture__design-system@15.6.1.patch"
    }
  }
}
