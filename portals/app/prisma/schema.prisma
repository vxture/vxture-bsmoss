  decidedBy String @map("decided_by")
  decidedAt DateTime @map("decided_at") @db.Timestamptz() @default(now())
  @@id([workspaceId,id])
  @@unique([workspaceId,measurementId,revision])
  @@index([workspaceId,measurementId,revision], map: "quality_measurement_revision")
  @@map("quality_decision")
  @@schema("bsmoss_metering")
}

