// Client-generation source only. Empty-database DDL baseline is authoritative.
// Scalar foreign keys; constraints and triggers are enforced by PostgreSQL.
generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  schemas = ["bsmoss_resource", "bsmoss_integration", "bsmoss_catalog", "bsmoss_metering", "bsmoss_views", "vx_provision", "local_authz", "local_usage", "bsmoss_analysis"]
}

