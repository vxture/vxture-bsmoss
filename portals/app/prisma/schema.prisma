// Client-generation source only. Empty-database DDL baseline is authoritative.
// Scalar foreign keys; constraints and triggers are enforced by PostgreSQL.
generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  schemas = ["bsmoss_resource", "bsmoss_integration", "bsmoss_catalog", "bsmoss_metering", "bsmoss_views", "vx_provision", "local_authz", "local_usage", "bsmoss_analysis"]
}

model Station {
  workspaceId String @map("workspace_id")
  id String
  name String
  ownerCode String @map("owner_code")
  provinceCode String @map("province_code")
  cityCode String @map("city_code")
  @@id([workspaceId,id])
  @@map("station")
  @@schema("bsmoss_resource")
}

model OperatorEntity {
  workspaceId String @map("workspace_id")
  id String
  category String
  name String
  @@id([workspaceId,id])
  @@map("operator_entity")
  @@schema("bsmoss_resource")
}

model StationService {
  workspaceId String @map("workspace_id")
  id String
  stationId String @map("station_id")
  operatorEntityId String @map("operator_entity_id")
  validFrom DateTime @map("valid_from") @db.Timestamptz()
  validTo DateTime @map("valid_to") @db.Timestamptz()
  @@id([workspaceId,id])
  @@unique([workspaceId,id,stationId])
  @@map("station_service")
  @@schema("bsmoss_resource")
}

model Device {
  workspaceId String @map("workspace_id")
  id String
  stationId String @map("station_id")
  deviceType String @map("device_type")
  ownership String
  @@id([workspaceId,id])
  @@unique([workspaceId,id,stationId])
  @@map("device")
  @@schema("bsmoss_resource")
}

model NetworkObject {
  workspaceId String @map("workspace_id")
  id String
  stationId String @map("station_id")
  serviceId String @map("service_id")
  kind String
  @@id([workspaceId,id])
  @@unique([workspaceId,id,stationId,serviceId])
