  @@schema("bsmoss_resource")
}

model Source {
  workspaceId String @map("workspace_id")
  id String
  name String
  protocol String
  @@id([workspaceId,id])
  @@map("source")
  @@schema("bsmoss_integration")
}

model MetricVersion {
  code String
  version Decimal @db.Decimal(30,0)
  category String
  semantic String
  unit String
  definition Json @db.JsonB
  @@id([code,version])
  @@map("metric_version")
  @@schema("bsmoss_catalog")
}

model SourceMapping {
  workspaceId String @map("workspace_id")
  id String
  sourceId String @map("source_id")
  externalType String @map("external_type")
  externalId String @map("external_id")
  stationId String @map("station_id")
  serviceId String? @map("service_id")
  networkObjectId String? @map("network_object_id")
  deviceId String? @map("device_id")
  version Decimal @db.Decimal(30,0)
  validFrom DateTime @map("valid_from") @db.Timestamptz()
  validTo DateTime @map("valid_to") @db.Timestamptz()
  @@id([workspaceId,id])
  @@unique([workspaceId,id,stationId,sourceId])
  @@map("source_mapping")
  @@schema("bsmoss_integration")
}

model RawEvent {
  workspaceId String @map("workspace_id")
  sourceId String @map("source_id")
  eventId String @map("event_id")
  revision Decimal @db.Decimal(30,0)
  previousRevision Decimal? @map("previous_revision") @db.Decimal(30,0)
  payloadSha256 String @map("payload_sha256")
  payloadUri String @map("payload_uri")
  occurredAt DateTime @map("occurred_at") @db.Timestamptz()
  receivedAt DateTime @map("received_at") @db.Timestamptz() @default(now())
  @@id([workspaceId,sourceId,eventId,revision])
  @@map("raw_event")
  @@schema("bsmoss_integration")
}

model SourceCapability {
  workspaceId String @map("workspace_id")
  id String
  sourceId String @map("source_id")
