model Measurement {
  workspaceId String @map("workspace_id")
  id String
  sourceId String @map("source_id")
  eventId String @map("event_id")
  eventRevision Decimal @map("event_revision") @db.Decimal(30,0)
  metricCode String @map("metric_code")
  metricVersion Decimal @map("metric_version") @db.Decimal(30,0)
  componentKey String @map("component_key")
  stationId String @map("station_id")
  mappingId String @map("mapping_id")
  transformVersion String @map("transform_version")
  periodStart DateTime @map("period_start") @db.Timestamptz()
  periodEnd DateTime @map("period_end") @db.Timestamptz()
  valueKind String @map("value_kind")
  integerValue Decimal? @map("integer_value") @db.Decimal(30,0)
  numerator Decimal? @db.Decimal(30,0)
  denominator Decimal? @db.Decimal(30,0)
  unscaled Decimal? @db.Decimal(30,0)
  scale Decimal? @db.Decimal(30,0)
  stateValue String? @map("state_value")
  validUntil DateTime? @map("valid_until") @db.Timestamptz()
  @@id([workspaceId,id])
  @@unique([workspaceId,sourceId,eventId,eventRevision,metricCode,metricVersion,componentKey])
  @@index([workspaceId,stationId,periodStart], map: "measurement_station_period")
  @@index([workspaceId,metricCode,metricVersion,periodStart], map: "measurement_metric_period")
  @@map("measurement")
  @@schema("bsmoss_metering")
}

model QualityDecision {
  workspaceId String @map("workspace_id")
  id String
  measurementId String @map("measurement_id")
