# Non-secret target profile. Copy to private app.env and complete registered credentials.
# Pending registry allocation: host port belongs in the separate stack.env.
BSMOSS_PRODUCT_PREVIEW=off
DEPLOY_STAGE=prod
BSMOSS_METERING_ENABLED=off
OIDC_RP_ENABLED=on
OIDC_CLIENT_MODE=third_party
OIDC_ISSUER=https://accounts.vxture.com
OIDC_CLIENT_ID=bsmoss
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://bsmoss.ruyin.work/api/auth/oidc/callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://bsmoss.ruyin.work/
OIDC_SCOPES=openid profile email
NEXT_PUBLIC_APP_URL=https://bsmoss.ruyin.work
NEXT_PUBLIC_WEBSITE_URL=https://vxture.com
NEXT_PUBLIC_CONSOLE_URL=https://ruyin.work/
REDIS_URL=redis://redis:6379
DATABASE_URL=
