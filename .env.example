# Sample-only feature flag. This is not authentication.
BSMOSS_PRODUCT_PREVIEW=off
# Set from the environment registry; use 0 for an ephemeral local test.
PORT=
HOSTNAME_BIND=127.0.0.1

# Runtime file only. DB owner credentials belong in a separate stack.env.
DEPLOY_STAGE=dev
BSMOSS_METERING_ENABLED=off
DATABASE_URL=
REDIS_URL=redis://redis:6379

# Registered values must match the platform records exactly.
OIDC_RP_ENABLED=off
# product or third_party; third_party disables S2S channel exchange.
OIDC_CLIENT_MODE=product
OIDC_ISSUER=https://accounts.vxture.com
OIDC_CLIENT_ID=bsmoss
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_POST_LOGOUT_REDIRECT_URI=
OIDC_SCOPES=openid profile email phone
RP_SESSION_TTL=2592000
RP_SESSION_COOKIE_NAME=
NEXT_PUBLIC_APP_URL=

# Bearer channel exchange; no shared platform internal password.
PLATFORM_API_URL=
S2S_CLIENT_ID=bsmoss
S2S_CLIENT_SECRET=
S2S_TOKEN_URL=
PROVISION_WEBHOOK_SECRET=
PROVISION_WEBHOOK_SECRET_NEXT=
NEXT_PUBLIC_WEBSITE_URL=https://vxture.com
NEXT_PUBLIC_CONSOLE_URL=https://console.vxture.com

# Operator branding persistence. Required outside the local product preview.
# Use an absolute persistent directory; replicas must share this volume.
BSMOSS_OPERATOR_IDENTITIES_DIR=

# Runtime monitoring parameters; persistent workspace-isolated configuration.
BSMOSS_MONITORING_PARAMETERS_DIR=

# Capacity analysis parameters; persistent workspace-isolated configuration.
BSMOSS_CAPACITY_PARAMETERS_DIR=

# Usage verification parameters; persistent workspace-isolated configuration.
BSMOSS_VERIFICATION_PARAMETERS_DIR=

# Local preview site/device supplementary records; not source master data.
BSMOSS_REGISTRY_MAINTENANCE_DIR=
